# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# AWS Credentials (required for SNS email alerts)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# AWS SNS Topic ARN for certificate alerts
# Create an SNS topic in your AWS account and paste the ARN here
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:YOUR_TOPIC_NAME

# Certificate monitoring settings
MONITOR_CHECK_INTERVAL=60
MONITOR_BATCH_SIZE=50
MONITOR_TIMEOUT=30

# Internal API base URL (used by ssl checker module)
SSL_API_BASE_URL=http://localhost:5000/api/ssl

# AWS Cognito — SPA (Vite) requires VITE_ prefix or values stay undefined in the browser
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=

# api_bridge.py loads `.env` then `.env.local` (override). It accepts either COGNITO_* or the
# same values as VITE_COGNITO_* above so local dev can use one `.env.local` for SPA + API.

# Legacy names (optional duplicate of VITE_* for scripts/tools)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Optional: when the backend has no COGNITO_USER_POOL_ID, it uses a local admin
# fallback user. Leave DEV_AUTH_NAME empty to show email in the UI instead of a
# placeholder display name.
# DEV_AUTH_EMAIL=dev@example.com
# DEV_AUTH_NAME=

# Entrust CA API credentials (production only)
# When set, step 3 submits the CSR to Entrust cloud CA
# instead of using the internal Mississippi ITS Root CA
# Get credentials from your Entrust account portal
ENTRUST_USERNAME=
ENTRUST_API_KEY=
ENTRUST_PASSWORD=
